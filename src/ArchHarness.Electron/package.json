{
  "name": "archharness-electron",
  "author": {
    "name": "Pepsi1x1"
  },
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "description": "Electron desktop wrapper for the local ArchHarness web host",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prepare:win-icon": "node scripts/generate-win-icon.mjs",
    "stamp:win-exe-icon": "node scripts/stamp-win-exe-icon.mjs",
    "bundle:web-host": "node scripts/publish-web-host.mjs",
    "pack:dir": "npm run prepare:win-icon && npm run bundle:web-host && electron-builder --dir --publish never",
    "pack:mac": "npm run bundle:web-host && electron-builder --mac zip --publish never",
    "pack:win": "node scripts/pack-win.mjs",
    "pack:linux": "npm run prepare:win-icon && npm run bundle:web-host && electron-builder --linux AppImage zip --publish never"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.0"
  },
  "build": {
    "appId": "com.archharness.desktop",
    "productName": "ArchHarness",
    "icon": "assets/icons/icon-1024.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-host-manager.js",
      "window-manager.js",
      "ipc-handlers.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/web-host",
        "to": "web-host",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "zip"
      ]
    }
  }
}
