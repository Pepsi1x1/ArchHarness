<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArchHarness.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#101317" />
      <Setter Property="Foreground" Value="#F5F7FA" />
    </Style>
    <Style Selector="TextBlock.hero">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="#0B0E12" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#151A20" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="#232A33" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#11161C" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="#242C36" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#F16436" />
      <Setter Property="Foreground" Value="#FFF7F2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </Application.Styles>
</Application>