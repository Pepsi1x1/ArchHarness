<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArchHarness.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush">#0A0F16</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#101720</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceSoftBrush">#0E151E</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceRaisedBrush">#151E29</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrushBase">#213040</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#F3F7FC</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#9AA9BC</SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedBrush">#6E8096</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#377DFF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentMutedBrush">#17345E</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#39B27A</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#F4BC55</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrush">#FF7A74</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Grid.appRoot">
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.navActive">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.navInactive">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="#0D131A" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.subtlePanel">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composerPanel">
      <Setter Property="Background" Value="#101821" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="#263546" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.badgeSubtle">
      <Setter Property="Background" Value="#0F1722" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.timelineDot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="#4E90F7" />
      <Setter Property="Foreground" Value="#F8FBFF" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#0E151E" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0D131A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0D131A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>