<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ArchHarness.Desktop.ViewModels"
        x:Class="ArchHarness.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Title="ArchHarness Desktop">
  <Grid Classes="appRoot" ColumnDefinitions="228,*,360" Margin="18">
    <Border Classes="sidebar" Grid.Column="0">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Spacing="4">
          <TextBlock Text="ArchHarness" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Desktop orchestration shell" Classes="caption" />
        </StackPanel>

        <Border Classes="subtlePanel" Grid.Row="1" Margin="0,18,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Focus" Classes="sectionTitle" />
            <TextBlock Text="Start a new session and follow it live. Previous runs are useful reference, not the primary workflow." Classes="caption" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Border Classes="badgeSubtle" ToolTip.Tip="{Binding PreflightStatusDetail}">
                <TextBlock Text="{Binding PreflightBadge}" Classes="caption" />
              </Border>
              <Border Classes="badgeSubtle">
                <TextBlock Text="{Binding RunCountBadge}" Classes="caption" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding RunStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="panel" Grid.Row="2" Margin="0,18,0,0">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Spacing="2">
              <TextBlock Text="Recent Runs" Classes="sectionTitle" />
              <TextBlock Text="Browse previous output when you need context or want to compare a session." Classes="caption" TextWrapping="Wrap" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Name="RunsListBox"
                     ItemsSource="{Binding RecentRuns}"
                     SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                     Margin="0,12,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RunSummaryViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Subtitle}" Classes="caption" />
                      <TextBlock Text="{Binding RunDirectory}" Classes="caption" Opacity="0.72" TextWrapping="Wrap" MaxHeight="34" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="16,0">
      <Border Classes="panel">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="New Session" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Describe the work, choose the workspace, start the run, then follow the timeline as the agents execute." Classes="caption" TextWrapping="Wrap" MaxWidth="620" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="14,0,0,0" Grid.Column="1">
            <Border Classes="badge" ToolTip.Tip="{Binding PreflightStatusDetail}">
              <TextBlock Text="{Binding PreflightBadge}" />
            </Border>
            <Border Classes="badgeSubtle">
              <TextBlock Text="{Binding RunStateBadge}" Classes="caption" />
            </Border>
            <Border Classes="badgeSubtle">
              <TextBlock Text="{Binding SelectedRunTitle}" Classes="caption" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="composerPanel" Grid.Row="1" Margin="0,18,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*">
          <StackPanel Grid.ColumnSpan="2" Spacing="6">
            <TextBlock Text="Task" Classes="sectionTitle" />
            <TextBox Text="{Binding TaskPrompt, Mode=TwoWay}"
                     AcceptsReturn="True"
                     MinHeight="112"
                     TextWrapping="Wrap"
                     Watermark="Describe the change or review loop you want ArchHarness to run." />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,14,0,0">
            <TextBlock Text="Workspace" Classes="sectionTitle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="WorkspacePathTextBox"
                       Text="{Binding WorkspacePath, Mode=TwoWay}"
                       Watermark="Path to workspace root" />
              <Button Name="RefreshWorkspaceButton" Classes="ghost" Grid.Column="1" Margin="10,0,0,0">Refresh Runs</Button>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="6">
            <TextBlock Text="Workspace Mode" Classes="sectionTitle" />
            <ComboBox ItemsSource="{Binding WorkspaceModes}" SelectedItem="{Binding WorkspaceMode, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,14,0,0" Spacing="6">
            <TextBlock Text="Permissions" Classes="sectionTitle" />
            <ComboBox ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding PermissionHandlerMode, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="6">
            <TextBlock Text="Workflow" Classes="sectionTitle" />
            <TextBox Text="{Binding Workflow, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,12,0,0" Spacing="6">
            <TextBlock Text="Project Name" Classes="sectionTitle" />
            <TextBox Text="{Binding ProjectName, Mode=TwoWay}" Watermark="Used for new-project workspace mode" />
          </StackPanel>

          <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="6">
            <TextBlock Text="Model Overrides" Classes="sectionTitle" />
            <TextBox Text="{Binding ModelOverridesText, Mode=TwoWay}" Watermark="role=model,role=model" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="12,12,0,0" Spacing="6">
            <TextBlock Text="Build Command" Classes="sectionTitle" />
            <TextBox Text="{Binding BuildCommand, Mode=TwoWay}" Watermark="Optional explicit build command" />
          </StackPanel>

          <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <StackPanel Spacing="8">
              <CheckBox Content="Architecture loop mode" IsChecked="{Binding ArchitectureLoopMode, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <CheckBox Content="Coding style" IsChecked="{Binding ReviewLoopCodingStyleEnabled, Mode=TwoWay}" />
                <CheckBox Content="Security" IsChecked="{Binding ReviewLoopSecurityEnabled, Mode=TwoWay}" />
                <CheckBox Content="Architecture" IsChecked="{Binding ReviewLoopArchitectureEnabled, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Margin="16,0,16,0"
                     Text="{Binding ArchitectureLoopPrompt, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="72"
                     Watermark="Optional architecture review prompt"
                     IsVisible="{Binding ArchitectureLoopMode}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
              <Button Name="GenerateSummaryButton" Classes="ghost" IsEnabled="{Binding CanStartRun}">Generate Summary</Button>
              <Button Name="StartRunButton" Classes="accent" IsEnabled="{Binding CanStartRun}">Start Run</Button>
              <Button Name="CancelRunButton" Classes="ghost" IsEnabled="{Binding CanCancelRun}">Cancel</Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Classes="panel" Grid.Row="2" Margin="0,18,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Live Timeline" Classes="sectionTitle" />
              <TextBlock Text="Follow the active session as it plans, executes, reviews, and writes artefacts." Classes="caption" />
            </StackPanel>
            <Border Grid.Column="1" Classes="badgeSubtle" VerticalAlignment="Top">
              <TextBlock Text="{Binding RunStateBadge}" Classes="caption" />
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding TimelineItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimelineItemViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="timelineDot" Background="{Binding AccentBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Subtitle}" Classes="caption" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.92" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Classes="panel" Grid.Column="2">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Spacing="2">
          <TextBlock Text="Follow Along" Classes="sectionTitle" />
          <TextBlock Text="Stream agent output, inspect Copilot session events, and review the current run's artefacts." Classes="caption" />
        </StackPanel>

        <TabControl Grid.Row="1" Grid.RowSpan="2" Margin="0,12,0,0">
          <TabItem Header="Agent Stream">
            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="Selected Agent" Classes="sectionTitle" />
                <ComboBox ItemsSource="{Binding AvailableAgents}"
                          SelectedItem="{Binding SelectedAgent, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentItemViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <Border Classes="subtlePanel" Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer>
                  <TextBlock Text="{Binding SelectedAgentTranscript}"
                             FontFamily="Courier New"
                             TextWrapping="Wrap" />
                </ScrollViewer>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Summary">
            <Border Classes="subtlePanel" Margin="0,12,0,0">
              <ScrollViewer>
                <StackPanel Spacing="8">
                  <TextBlock Text="Request summary" Classes="sectionTitle" />
                  <TextBlock Text="{Binding SetupSummary}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SetupValidationMessage}" Foreground="#FF8A8A" TextWrapping="Wrap" IsVisible="{Binding HasSetupValidationMessage}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </TabItem>

          <TabItem Header="Session Events">
            <ScrollViewer Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding SessionEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionEventItemViewModel">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SessionLabel}" Classes="caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Artefacts">
            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
              <ListBox Grid.Row="0"
                       Name="ArtifactsListBox"
                       ItemsSource="{Binding Artifacts}"
                       SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                       MaxHeight="240">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ArtifactItemViewModel">
                    <Border Classes="card">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Classes="subtlePanel" Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer>
                  <TextBlock Text="{Binding SelectedArtifactPreview}"
                             FontFamily="Courier New"
                             TextWrapping="Wrap" />
                </ScrollViewer>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</Window>